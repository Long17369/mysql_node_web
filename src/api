## 数据类型定义

### TypeScript 类型定义

如果您使用 TypeScript，可以参考以下类型定义：

```typescript
// 统一响应格式
interface SuccessResponse<T> {
  success: true;
  data: T;
}

interface ErrorResponse {
  success: false;
  error: {
    message: string;
    code: 'INVALID_PARAMETER' | 'DATABASE_ERROR' | 'UNKNOWN_ERROR';
  };
}

type ApiResponse<T> = SuccessResponse<T> | ErrorResponse;

// 字段映射类型
interface FieldMapper {
  id: number;
  f_name: string;
  db_name: string;
  p_name: string;
  unit: string;
  type: '1' | '2' | '3';  // 1: 文本, 2: 图片, 3: 视频
  visible: '0' | '1';     // 0: 不可见, 1: 可见
}

// 传感器数据类型
interface SensorData {
  id: number;
  d_no: string | null;
  field1: string | null;
  field2: string | null;
  field3: string | null;
  field4: string | null;
  field5: string | null;
  field6: string | null;
  field7: string | null;
  field8: string | null;
  field9: string | null;
  field10: string | null;
  c_time: string;  // ISO 8601 格式
  online: string | null;  // "实时数据" | "保存数据"
}

// 行为数据类型
interface BehaviorData {
  id: number;
  d_no: string | null;
  field1: string | null;
  field2: string | null;
  field3: string | null;
  field4: string | null;
  field5: string | null;
  field6: string | null;
  field7: string | null;
  field8: string | null;
  field9: string | null;
  field10: string | null;
  c_time: string;  // ISO 8601 格式
  online: string | null;  // "实时数据" | "保存数据"
}

// 查询参数
interface DataQueryParams {
  limit?: number;    // 默认: 10, 最大: 1000
  offset?: number;   // 默认: 0
  order_table?: string;  // 默认: "id"
  desc?: boolean | 'true' | '1';  // 默认: false
}

// API 响应类型
type SensorMapperResponse = ApiResponse<FieldMapper[]>;
type BehaviorMapperResponse = ApiResponse<FieldMapper[]>;
type SensorDataResponse = ApiResponse<SensorData[]>;
type BehaviorDataResponse = ApiResponse<BehaviorData[]>;
```

